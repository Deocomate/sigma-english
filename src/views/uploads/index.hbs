{{#> page-header title=title subtitle=(concat "Ảnh (PNG, JPG, GIF, WebP), PDF hoặc MP3, tối đa " maxMb " MB mỗi file.")}}{{/page-header}}

<div class="card card-body mb-6">
  <label for="upload-input" class="label">Chọn file để tải lên</label>
  <input id="upload-input" type="file" class="input" accept="{{accept}}" multiple data-upload-input>
  <p class="mt-2 text-sm text-slate-500" data-upload-status role="status" aria-live="polite"></p>
</div>

{{#if items.length}}
  <div class="card divide-y divide-slate-100">
    {{#each items}}
      <div class="flex flex-wrap items-center gap-4 p-4">
        {{#if isImage}}
          <img src="/uploads/{{id}}/file" alt="" loading="lazy" class="h-14 w-14 shrink-0 rounded-lg bg-slate-100 object-cover">
        {{else}}
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-xs font-semibold text-slate-500">{{#if (eq mime "application/pdf")}}PDF{{else}}MP3{{/if}}</div>
        {{/if}}
        <div class="min-w-0 flex-1">
          <a href="/uploads/{{id}}/file" target="_blank" rel="noopener" class="block truncate font-medium text-brand-600 hover:underline">{{original_name}}</a>
          <p class="text-sm text-slate-500">{{sizeLabel}} · {{formatDate created_at}}{{#if @root.isAdmin}} · {{owner_name}}{{/if}}</p>
        </div>
        <form method="post" action="/uploads/{{id}}/delete" data-confirm="Xoá file này?">
          {{> form/csrf}}
          <button type="submit" class="btn-ghost btn-sm">Xoá</button>
        </form>
      </div>
    {{/each}}
  </div>
{{else}}
  {{> empty-state title="Chưa có file nào" text="Chọn file ở khung phía trên để tải lên."}}
{{/if}}
